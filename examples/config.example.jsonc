{
  "$schema": "https://opencode.ai/config.json",

  // Default = thin orchestrator. It sees bash/edit/webfetch/task and no MCP.
  // Wide profile with direct MCP = the built-in "build" agent, switch in UI.
  "default_agent": "main",

  "provider": {
    "your-provider": {
      "name": "Your Provider",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://your-llm-endpoint.example"
      },
      "models": {
        "your-model": { "name": "your-model" }
      }
    }
  },

  // Secrets never live here. Use env interpolation.
  "mcp": {
    "example-tracker": {
      "type": "remote",
      "url": "https://tracker.example/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:TRACKER_TOKEN}"
      }
    },
    "example-chat": {
      "type": "local",
      "command": ["node", "path/to/chat-mcp.js"],
      "enabled": true,
      "environment": {
        "CHAT_API_URL": "https://chat.example",
        "CHAT_API_KEY": "{env:CHAT_API_KEY}"
      }
    }
  },

  "tool_output": {
    "max_lines": 500,
    "max_bytes": 24000
  },

  "compaction": {
    "auto": true,
    "preserve_recent_tokens": 8000,
    "reserved": 16000
  }
}
